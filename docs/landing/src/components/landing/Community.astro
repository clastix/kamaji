---
import GitHub from '../../assets/icons/github.svg';
import Slack from '../../assets/icons/slack.svg';
import Chat from '../../assets/icons/message-chat-circle.svg';
import Heart from '../../assets/icons/heart-hand.svg';

const items = [
  { icon: GitHub, title: 'GitHub', text: 'Star the repo, watch releases, report issues.', href: 'https://github.com/clastix/kamaji' },
  { icon: Slack, title: '#kamaji on Slack', text: 'Ask questions on the Kubernetes Slack.', href: 'https://kubernetes.slack.com/archives/C03GLTTMWNN' },
  { icon: Chat, title: 'Discussions', text: 'Share ideas and feature requests.', href: 'https://github.com/clastix/kamaji/discussions' },
  { icon: Heart, title: 'Contribute', text: 'Read the guidelines and open a pull request.', href: '/guides/contribute/' },
];
---

<section class="mx-auto max-w-page px-4 lg:px-12 pt-16 lg:pt-24">
  <p class="text-sm font-semibold uppercase text-eyebrow lg:text-md">Open source</p>
  <h2 class="mt-3 text-display-sm font-semibold text-brand-dark-blue-800 lg:text-display-md">Join the community</h2>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {items.map(({ icon: Icon, title, text, href }) => (
      <a href={href} class="group flex flex-col gap-3 rounded-xl border border-neutral-200 bg-white p-6 hover:border-brand-dark-blue-300">
        <Icon class="size-6 text-brand-dark-blue-500" />
        <span class="font-semibold text-brand-dark-blue-800 group-hover:underline">{title}</span>
        <span class="text-sm text-neutral-600">{text}</span>
      </a>
    ))}
  </div>
</section>
